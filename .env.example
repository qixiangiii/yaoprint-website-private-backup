# 起元星启官网 — 部署配置
# 复制为 .env 后修改。该文件不会被提交到 Git，也不会被站点静态访问。

# 运行模式：production 会开启安全 Cookie、隐藏错误堆栈、要求 HTTPS
NODE_ENV=production

# 服务监听端口。宝塔里若已被占用，改成 3001、8080 等
PORT=3000

# 会话签名密钥，必填。生成方式：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# 站点对外地址，用于 sitemap 与分享链接。结尾不要带斜杠
# SITE_URL=https://www.example.com
